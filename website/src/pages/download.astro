---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, DOWNLOADS, RELEASES_BASE, url } from "../lib/site";

// Builds are unsigned — no Apple or Windows signing certificates. Saying so
// up front is kinder than letting someone hit an OS block and conclude the
// download is broken.
// How to actually get each platform to run this.
//
// Builds are unsigned, and on macOS that is no longer a warning you can click
// past: Apple removed the Control-click Gatekeeper override in Sequoia, so the
// old "right-click → Open" advice leaves people stuck. The Terminal route
// below is the one that still works.
//
// On Linux the obstacle is not security at all — double-clicking a .deb hands
// it to GNOME Software, whose local-file install commonly hangs on a progress
// bar forever. Installing from a terminal sidesteps it entirely.
const FIRST_RUN: Record<string, { note: string; cmd?: string }> = {
  // Commands are globbed rather than naming one architecture. Each card offers
  // two, and a copy-pasteable command naming the wrong one is worse than none.
  linux: {
    note: "Install from a terminal — double-clicking the .deb hands it to GNOME Software, whose local-package installer commonly hangs on a progress bar forever. Or extract the tarball and run bin/alterm.",
    cmd: "cd ~/Downloads\nsudo apt install ./alterm-linux-*.deb",
  },
  macos: {
    // `xattr -c` rather than `-d com.apple.quarantine`: it exits cleanly when
    // the attribute is absent. `installer` is the CLI path, which is not
    // subject to the Gatekeeper gate that Installer.app applies.
    note: "Unsigned build. macOS refuses it on open, and right-click → Open no longer overrides that — Apple removed the Control-click bypass in Sequoia. Install from Terminal instead:",
    cmd: "cd ~/Downloads\nxattr -c alterm-macos-*.pkg\nsudo installer -pkg alterm-macos-*.pkg -target /",
  },
  windows: {
    note: "Unsigned build. SmartScreen will warn — choose More info, then Run anyway.",
  },
};
---

<BaseLayout
  title="Download"
  description={`Download Alterm ${SITE.version} for Linux, macOS, or Windows.`}
>
  <section class="container dl">
    <p class="eyebrow">Download</p>
    <h1>Alterm <span class="ver">v{SITE.version}</span></h1>
    <p class="lede">
      Prebuilt installers for Linux, macOS, and Windows. Builds are unsigned, so
      macOS and Windows warn on first launch — each card says how to get past
      it.
    </p>

    {/*
      All three platforms render statically. The inline script adds
      `has-detection` here and `is-detected` to the match, which is what
      promotes one card and demotes the rest. With no JS, none of those classes
      exist and this stays three equal cards — the same page, just without a
      recommendation.
    */}
    <div class="grid" id="dl-grid">
      {
        DOWNLOADS.map((d) => (
          <article class="card dl-card" data-os={d.os}>
            <p class="recommended">Recommended for you</p>
            <h2>{d.label}</h2>
            {/* One button per architecture. Never collapsed into a single
                "Download" — the browser cannot tell which CPU you are on. */}
            <div class="variants">
              {d.variants.map((v) => (
                <a class="btn btn-primary dl-btn" href={`${RELEASES_BASE}/${v.file}`}>
                  <span class="vlabel">
                    {d.variants.length > 1 ? v.note : `Download for ${d.label}`}
                  </span>
                  <code class="vfile">{v.file}</code>
                </a>
              ))}
            </div>
            {d.extras.length > 0 && (
              <ul class="alts">
                {d.extras.map((a) => (
                  <li>
                    <a href={`${RELEASES_BASE}/${a.file}`}>
                      <code>{a.file}</code>
                    </a>
                    <span class="note">{a.note}</span>
                  </li>
                ))}
              </ul>
            )}
            <div class="firstrun">
              <p>{FIRST_RUN[d.os].note}</p>
              {FIRST_RUN[d.os].cmd && <pre><code>{FIRST_RUN[d.os].cmd}</code></pre>}
            </div>
          </article>
        ))
      }
      <p class="others-label">Other platforms</p>
    </div>

    <p class="meta">
      <a href={`${RELEASES_BASE}/SHA256SUMS`}>Checksums</a>
      <span aria-hidden="true">·</span>
      <a href={`${SITE.repo}/releases`}>All releases</a>
      <span aria-hidden="true">·</span>
      <a href={url("/docs/installation")}>Build from source</a>
    </p>
  </section>

  <script>
    // Bundled (not is:inline) so it shares detectOs with the unit tests in
    // scripts/check-detect-os.mjs. Detection is progressive enhancement: it
    // only reorders and restyles cards that are already in the HTML.
    import { detectOs } from "../lib/detect-os.js";

    const os = detectOs(navigator.platform, navigator.userAgent);
    const grid = document.getElementById("dl-grid");
    const card = os && grid?.querySelector(`[data-os="${os}"]`);

    // No match (phone, ChromeOS, unknown) leaves the page exactly as served.
    if (grid && card) {
      card.classList.add("is-detected");
      grid.classList.add("has-detection");
    }
  </script>
</BaseLayout>

<style>
  .dl {
    padding: clamp(40px, 6vw, 80px) 0 clamp(56px, 8vw, 96px);
  }
  .dl h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3rem);
    margin: 0 0 10px;
  }
  .ver {
    font-family: var(--font-mono);
    font-size: 0.5em;
    color: var(--text-muted);
    vertical-align: middle;
  }
  .lede {
    color: var(--text-muted);
    max-width: 62ch;
    margin: 0 0 34px;
  }

  /* ---------- Baseline: no JS, or an unrecognised platform ---------- */
  /* Three equal cards. Nothing is hidden and nothing is recommended. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .dl-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px;
  }
  .dl-card h2 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0;
  }
  /* Both only ever appear once detection has run. */
  .recommended,
  .others-label {
    display: none;
  }

  /* ---------- Enhanced: detection succeeded ---------- */
  /* One dominant card, then a label, then the rest compact underneath. */
  .grid.has-detection {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .grid.has-detection .is-detected {
    order: -1;
    padding: 28px;
    border-color: var(--accent-dim);
    box-shadow: var(--glow);
  }
  .grid.has-detection .others-label {
    display: block;
    order: 0;
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .grid.has-detection .dl-card:not(.is-detected) {
    order: 1;
  }

  .is-detected .recommended {
    display: block;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .is-detected h2 {
    font-size: 1.5rem;
  }

  /* Demote the other platforms to a single compact row each: no big button,
     no first-run note — that belongs with the download you actually take. */
  .grid.has-detection .dl-card:not(.is-detected) {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    padding: 12px 16px;
  }
  .grid.has-detection .dl-card:not(.is-detected) h2 {
    font-size: 0.95rem;
    min-width: 72px;
  }
  .grid.has-detection .dl-card:not(.is-detected) .dl-btn {
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* A compact row is a signpost, not a menu: it links through to the platform
     without reproducing its architecture choices or install notes. Those
     belong on the card you actually came for. */
  .grid.has-detection .dl-card:not(.is-detected) .alts,
  .grid.has-detection .dl-card:not(.is-detected) .firstrun,
  .grid.has-detection .dl-card:not(.is-detected) .vfile {
    display: none;
  }
  /* Collapse multiple architectures to the first link when demoted. */
  .grid.has-detection .dl-card:not(.is-detected) .variants {
    flex-direction: row;
    gap: 14px;
  }

  /* ---------- Shared bits ---------- */
  .variants {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .dl-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    text-align: left;
  }
  .vlabel {
    font-weight: 600;
  }
  .vfile {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.75;
  }
  .alts code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
  .note {
    color: var(--text-faint);
    font-size: 0.8rem;
  }
  .alts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.82rem;
  }
  .alts li {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
  }
  .firstrun pre {
    margin: 8px 0 0;
    padding: 10px 12px;
    background: var(--bg-elev-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow-x: auto;
  }
  .firstrun code {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    white-space: pre;
  }
  .firstrun p {
    margin: 0;
  }
  .firstrun {
    margin: auto 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    color: var(--text-faint);
    font-size: 0.8rem;
  }
  .meta {
    margin: 30px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.86rem;
    color: var(--text-muted);
  }
</style>
